<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.taskmanager.controller.PreferencesDialogController"
      spacing="20.0" prefWidth="480.0" styleClass="dialog-root">
    
    <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0" />
    </padding>
    
    <!-- Header -->
    <VBox spacing="6.0">
        <Label text="Preferences" styleClass="dialog-header-title" />
        <Label text="Customize application settings and behaviors." styleClass="dialog-header-subtitle" />
    </VBox>
    
    <Separator styleClass="dialog-separator" />
    
    <!-- Body -->
    <VBox spacing="16.0" VBox.vgrow="ALWAYS">
        <!-- Appearance Settings -->
        <VBox spacing="12.0" styleClass="settings-section">
            <Label text="APPEARANCE" styleClass="settings-section-title" />
            
            <GridPane hgap="12.0" vgap="12.0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="40.0" />
                    <ColumnConstraints percentWidth="60.0" />
                </columnConstraints>
                
                <Label text="Theme Mode" styleClass="label-form" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <ComboBox fx:id="comboTheme" maxWidth="Infinity" prefHeight="34.0" GridPane.rowIndex="0" GridPane.columnIndex="1" />
            </GridPane>
        </VBox>
        
        <Separator styleClass="dialog-separator" />
        
        <!-- Task Defaults -->
        <VBox spacing="12.0" styleClass="settings-section">
            <Label text="TASK DEFAULTS" styleClass="settings-section-title" />
            
            <GridPane hgap="12.0" vgap="12.0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="40.0" />
                    <ColumnConstraints percentWidth="60.0" />
                </columnConstraints>
                
                <Label text="Default Priority" styleClass="label-form" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <ComboBox fx:id="comboDefaultPriority" maxWidth="Infinity" prefHeight="34.0" GridPane.rowIndex="0" GridPane.columnIndex="1" />
            </GridPane>
        </VBox>
        
        <Separator styleClass="dialog-separator" />
        
        <!-- Storage -->
        <VBox spacing="12.0" styleClass="settings-section">
            <Label text="STORAGE &amp; PERSISTENCE" styleClass="settings-section-title" />
            
            <GridPane hgap="12.0" vgap="10.0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="40.0" />
                    <ColumnConstraints percentWidth="60.0" />
                </columnConstraints>
                
                <Label text="Tasks Database" styleClass="label-form" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <Label text="data/tasks.json" style="-fx-text-fill: -color-text-secondary;" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                
                <Label text="Categories Database" styleClass="label-form" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <Label text="data/categories.json" style="-fx-text-fill: -color-text-secondary;" GridPane.rowIndex="1" GridPane.columnIndex="1" />
            </GridPane>
        </VBox>
    </VBox>
    
    <Separator styleClass="dialog-separator" />
    
    <!-- Footer Actions -->
    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <Button fx:id="btnClose" text="Close" onAction="#handleClose" styleClass="btn-secondary" prefWidth="120.0" prefHeight="36.0" />
    </HBox>
</VBox>
